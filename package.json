{
  "name": "optionalrule-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "INCLUDE_DRAFTS=true next dev",
    "graph:hooks": "bash scripts/install-graphify-hooks.sh",
    "graph:update": "bash scripts/update-code-graph.sh",
    "build": "npm run generate-search-index && npm run generate-rss && next build",
    "enhance-post": "node --import tsx/esm scripts/enhance-post.mjs",
    "verify-titles": "node scripts/verify-titles.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:ci": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run --config vitest.unit.config.ts",
    "test:watch": "vitest --config vitest.unit.config.ts",
    "test:ui": "vitest --ui --config vitest.unit.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.unit.config.ts",
    "test:ci": "npm run typecheck && npm run lint:ci && npm run validate-config && npm run test:coverage",
    "test:integration": "vitest run --config vitest.unit.config.ts --run src/__tests__/integration.test.ts",
    "test:ssg": "vitest run --config vitest.unit.config.ts --run src/__tests__/ssg.test.ts",
    "test:a11y": "vitest run --config vitest.unit.config.ts --run src/__tests__/accessibility.test.tsx",
    "test:star-system-golden:update": "STAR_SYSTEM_GOLDEN_UPDATE=1 vitest run --config vitest.unit.config.ts src/features/tools/star_system_generator/__tests__/generator-golden.test.ts",
    "test:star-system-generator": "npm run test -- --run src/features/tools/star_system_generator && npm run audit:star-system-generator",
    "test:build": "npm run build && npm run test:static",
    "test:static": "node -e \"const fs=require('fs');const need=['index.html','404.html','rss.xml','search-index.json','sitemap.xml','robots.txt'];const bad=need.filter(n=>!fs.existsSync('out/'+n)||fs.statSync('out/'+n).size===0);if(bad.length){console.error('Static export is missing: '+bad.map(n=>'out/'+n).join(', '));process.exit(1)}console.log('Static export verified: '+need.length+' required files in out/')\"",
    "test:all": "npm run test && npm run test:build",
    "generate-search-index": "node --import tsx/esm scripts/generate-search-index.ts",
    "create-post": "node --import tsx/esm scripts/create-post.ts",
    "replace-default-images": "node --import tsx/esm scripts/replace-default-images.ts",
    "download-external-images": "node --import tsx/esm scripts/download-external-images.ts",
    "find-empty-links": "node --import tsx/esm scripts/find-empty-links.ts",
    "generate-rss": "node --import tsx/esm scripts/generate-rss.ts",
    "sort:star-system-names": "node --import tsx/esm scripts/sort-star-system-names.ts",
    "audit:star-system-data": "node --import tsx/esm scripts/audit-star-system-data.ts",
    "audit:star-system-generator": "node --import tsx/esm scripts/audit-star-system-generator.ts",
    "audit:star-system-environments": "node --import tsx/esm scripts/audit-star-system-environments.ts",
    "audit:star-system-generator:quick": "STAR_SYSTEM_AUDIT_PROFILE=quick node --import tsx/esm scripts/audit-star-system-generator.ts",
    "audit:star-system-generator:deep": "STAR_SYSTEM_AUDIT_PROFILE=deep node --import tsx/esm scripts/audit-star-system-generator.ts",
    "audit:star-system-generator:baseline": "STAR_SYSTEM_AUDIT_UPDATE_BASELINE=1 node --import tsx/esm scripts/audit-star-system-generator.ts",
    "generate-star-system-hooks": "node --import tsx/esm scripts/generate-hooks-json.ts",
    "validate-config": "node --import tsx/esm scripts/validate-config.ts"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@tailwindcss/typography": "^0.5.20",
    "@types/mdx": "^2.0.14",
    "fuse.js": "^7.5.0",
    "globby": "^16.2.4",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.77.0",
    "next": "^16.4.6",
    "next-mdx-remote": "^6.0.0",
    "postprocessing": "^6.39.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reading-time": "^1.5.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.187.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/hast": "^3.0.4",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@typescript-eslint/eslint-plugin": "8.73.0",
    "@typescript-eslint/parser": "8.73.0",
    "@vitest/coverage-v8": "^5.1.1",
    "baseline-browser-mapping": "^2.11.39",
    "eslint": "9.39.5",
    "eslint-config-next": "^16.4.6",
    "happy-dom": "^21.0.4",
    "jest-axe": "^11.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwindcss": "^4.3.5",
    "three-stdlib": "^2.36.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "typescript-eslint": "8.73.0",
    "@typescript-eslint/eslint-plugin": "8.73.0",
    "@typescript-eslint/parser": "8.73.0",
    "postcss": "8.5.25",
    "sharp": "0.35.5",
    "postcss-selector-parser": "6.1.6"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "unrs-resolver@1.12.2": true
  }
}
