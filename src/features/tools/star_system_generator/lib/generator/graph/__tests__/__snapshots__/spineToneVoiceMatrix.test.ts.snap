exports[`spine tone × edge type voice matrix > tone=astronomy: spine prose reads in tone voice 1`] = `
{
  "body0": "The recurrence interval of the captured rogue world has shortened past the maintenance cycle Tau Reticuli Cohort was budgeted for. Models fitted to the refugee ark parking orbit five years ago now underpredict its reach by an order of magnitude at Custos Echo-58 Belt VI. Structural telemetry from Custos Echo-58 Belt IV shows secular degradation correlated with the captured rogue world at high confidence. Structural loads at Custos Echo-58 Belt IV Charter run at the upper bound of what Custos Echo-58 Belt IV's substrate was rated for.",
  "spineEdgeType": "DESTABILIZES",
  "spineSummary": "Captured rogue world took shape in the third pulse cycle, the perturbation from the captured rogue world now exceeds Tau Reticuli Cohort's tolerance margin.",
}
`;

