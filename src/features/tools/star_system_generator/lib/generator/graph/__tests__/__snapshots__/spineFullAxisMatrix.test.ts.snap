exports[`spine full axis matrix (16 representative cells) > baseline-frontier-balanced: stable spine + body[0] structural fields 1`] = `
{
  "body0": "Strip away the filings and the cause is plain — the arbitration that used to settle this dissolved with its sponsor. Helion Debt Synod presses, Ninth Ledger Office holds, and Glasshouse Biosafety Compact pays for both: a clinic that treats casualties from either camp and bills neither. Somebody keeps updating the evacuation postings, and somebody keeps taking them down. Neither Glasshouse Biosafety Compact nor Ninth Ledger Office will blink first, and Ash Meridian Navy absorbs the difference — a supply run that arrives only when the lanes are calm. Nothing has broken yet; everything is being measured for it. And there is the part no one says at the negotiating table: The compact between Glasshouse Biosafety Compact and Ninth Ledger Office fractured before the gate cooled.. Prices quoted to Glasshouse Biosafety Compact and Ninth Ledger Office differ by a margin every vendor denies. Ash Meridian Navy wants a monopoly that dies the moment anyone measures it; Glasshouse Biosafety Compact guards their standing as the ones who kept everyone alive; Ninth Ledger Office gets rationed air while the principals negotiate. The dispute has a second floor: Ash Meridian Navy sold Glasshouse Biosafety Compact out after the great rerouting, and kept the proceeds close ever since.. Cargo manifests between the two camps now travel with notarized seals nobody used to bother with.",
  "spineEdgeType": "CONTESTS",
  "spineObjectKind": "namedFaction",
  "spineSubjectKind": "namedFaction",
  "spineSummary": "Everything else in this system is priced against the quarrel between Helion Debt Synod and Ninth Ledger Office.",
  "spineVisibility": "contested",
}
`;

